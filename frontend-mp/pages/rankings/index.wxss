.rank {
  min-height: 100vh;
  background: #F8F8FC;
  padding: 24rpx 24rpx 40rpx;
}

/* ===== 头部 ===== */
.rank__head {
  margin-bottom: 24rpx;
}
.rank__title {
  font-family: 'Noto Serif SC', 'STSong', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1B2E;
}
.rank__sub {
  font-size: 22rpx;
  color: #8B8FA8;
  margin-top: 4rpx;
}

/* ===== 舞种分段 ===== */
.seg {
  display: flex;
  background: #F3F4F8;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.seg__item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #8B8FA8;
  transition: all 0.15s;
}
.seg__item--active {
  background: #FFFFFF;
  color: #1A1B2E;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* ===== 级别下划线 ===== */
.age-tabs {
  display: flex;
  margin-bottom: 24rpx;
}
.age-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-bottom: 4rpx solid rgba(0, 0, 0, 0.08);
  color: #8B8FA8;
  font-size: 26rpx;
  transition: all 0.15s;
}
.age-tab--active {
  border-bottom-color: #E8960A;
  color: #E8960A;
  font-weight: 700;
}

/* ===== 搜索框 ===== */
.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F3F4F8;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 16rpx;
}
.search__icon {
  font-size: 28rpx;
  color: #94A3B8;
}
.search__input {
  flex: 1;
  font-size: 26rpx;
  color: #1E293B;
}
.search__ph {
  color: #94A3B8;
}

/* ===== 表头 ===== */
.thead {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #F1F5F9;
  border-bottom: 1rpx solid #E2E8F0;
  font-size: 22rpx;
  font-weight: 700;
  color: #94A3B8;
  letter-spacing: 2rpx;
}
.thead__rank {
  width: 88rpx;
  text-align: center;
}
.thead__name {
  flex: 1;
}
.thead__change {
  width: 112rpx;
  text-align: center;
}
.thead__score {
  width: 128rpx;
  text-align: right;
}

/* ===== 榜单 ===== */
.tbody {
  background: #FFFFFF;
}

/* 晋级区标签 */
.zone-label {
  display: flex;
  justify-content: center;
  background: #FCE4EC;
  padding: 4rpx 32rpx 0;
}
.zone-label__text {
  background: #1A1A2E;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 4rpx 20rpx;
  border-radius: 0 0 10rpx 10rpx;
}

/* 未晋级区分隔 */
.zone-divider {
  position: relative;
}
.zone-divider__line {
  height: 1rpx;
  background: #E2E8F0;
}
.zone-divider__tag {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #F1F5F9;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 6rpx 28rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #94A3B8;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.zone-divider__gap {
  height: 16rpx;
  background: #F5F7FA;
}

/* ===== 行 ===== */
.row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #F1F5F9;
  background: #FFFFFF;
}
.row--advancing {
  background: #FCE4EC;
}

.cell {
  display: flex;
}
.cell--rank {
  width: 88rpx;
  align-items: center;
  justify-content: center;
}
.cell--name {
  flex: 1;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}
.cell--change {
  width: 112rpx;
  align-items: center;
  justify-content: center;
}
.cell--score {
  width: 128rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

/* 排名 */
.medal {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}
.rank-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #94A3B8;
}

/* 头像与姓名 */
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 4rpx solid #E2E8F0;
  flex-shrink: 0;
  background: #F1F5F9;
}
.name-wrap {
  min-width: 0;
}
.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.reason {
  font-size: 20rpx;
  color: #92400E;
  margin-top: 4rpx;
}

/* 名次变化 */
.change {
  font-weight: 700;
  display: flex;
  align-items: center;
}
.change--up {
  color: #16A34A;
  font-size: 22rpx;
}
.change--down {
  color: #DC2626;
  font-size: 22rpx;
}
.change--same {
  color: #CBD5E1;
  font-size: 28rpx;
}
.change--new {
  font-size: 20rpx;
  font-weight: 700;
  color: #0EA5E9;
  background: #E0F2FE;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 积分 */
.score {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}
.direct {
  font-size: 18rpx;
  font-weight: 700;
  background: #F59E0B;
  color: #1A0A00;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 96rpx 0;
  color: #94A3B8;
}
.empty__icon {
  font-size: 72rpx;
}
.empty__text {
  font-size: 28rpx;
  margin-top: 16rpx;
}
