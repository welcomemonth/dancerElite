.profile {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 60rpx;
}

/* ===== 用户横幅 ===== */
.banner {
  background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 60%, #1e3a8a 100%);
  padding: 60rpx 40rpx 100rpx;
  position: relative;
  overflow: hidden;
}
.banner__glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(40rpx);
}
.banner__glow--1 {
  width: 280rpx;
  height: 280rpx;
  background: rgba(96, 165, 250, 0.4);
  top: -80rpx;
  right: -60rpx;
}
.banner__glow--2 {
  width: 200rpx;
  height: 200rpx;
  background: rgba(147, 197, 253, 0.28);
  bottom: -40rpx;
  left: -30rpx;
}

.user-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
  backdrop-filter: blur(20rpx);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.user-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}
.tag-warning {
  background: rgba(245, 158, 11, 0.18);
  color: #fbbf24;
}

/* ===== 菜单组 ===== */
.menu-group {
  margin: -40rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  position: relative;
}
.menu-group:not(:first-of-type) {
  margin-top: 0;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  transition: background 0.15s ease;
}
.menu-row:last-child {
  border-bottom: none;
}
.menu-row:active {
  background: #f8fafc;
}

.menu-icon {
  width: 60rpx;
  font-size: 36rpx;
  text-align: left;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 500;
}

.menu-arrow {
  color: #cbd5e1;
  font-size: 36rpx;
  line-height: 1;
}

/* ===== 版本 ===== */
.version {
  text-align: center;
  font-size: 24rpx;
  color: #cbd5e1;
  margin-top: 60rpx;
}
