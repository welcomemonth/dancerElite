.detail {
  min-height: 100vh;
  background: #F8F8FC;
  padding-bottom: 60rpx;
}

/* ===== Banner ===== */
.banner {
  position: relative;
  height: 260rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}
.banner__deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}
.banner__deco--1 {
  top: 20rpx;
  right: 16rpx;
  width: 120rpx;
  height: 120rpx;
}
.banner__deco--2 {
  top: 44rpx;
  right: 44rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.06);
}
.banner__deco--3 {
  top: 70rpx;
  right: 70rpx;
  width: 28rpx;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.08);
}
.banner__inner {
  padding-right: 160rpx;
}
.banner__name {
  font-family: 'Noto Serif SC', 'STSong', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}
.banner__org {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 8rpx;
}
.banner__badge {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.banner__badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

/* ===== 信息卡 ===== */
.info {
  background: #FFFFFF;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}
.info__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #1A1B2E;
  margin-bottom: 14rpx;
}
.info__icon {
  font-size: 26rpx;
  flex-shrink: 0;
}
.info__text {
  color: #1A1B2E;
}
.info__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
}
.chip {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.chip--style {
  background: rgba(255, 45, 85, 0.1);
  color: #FF6B8A;
  border: 1rpx solid rgba(255, 45, 85, 0.2);
}
.chip--age {
  background: rgba(245, 166, 35, 0.1);
  color: #F5C55C;
  border: 1rpx solid rgba(245, 166, 35, 0.2);
}

/* ===== 内容容器 ===== */
.content {
  padding: 28rpx 32rpx;
}

/* ===== 通用段落 ===== */
.section {
  margin-bottom: 28rpx;
}
.section__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1B2E;
  margin-bottom: 16rpx;
}
.section__text {
  font-size: 26rpx;
  color: #8B8FA8;
  line-height: 1.75;
}

/* ===== 预宣传：倒计时 ===== */
.countdown {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.07), rgba(109, 40, 217, 0.04));
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  border: 1rpx solid rgba(139, 92, 246, 0.18);
  margin-bottom: 28rpx;
}
.countdown__label {
  font-size: 22rpx;
  color: #7C3AED;
  margin-bottom: 8rpx;
}
.countdown__num {
  font-size: 80rpx;
  font-weight: 700;
  color: #7C3AED;
  letter-spacing: 4rpx;
  line-height: 1;
}
.countdown__unit {
  font-size: 26rpx;
  color: rgba(124, 58, 237, 0.6);
  margin-bottom: 8rpx;
}
.countdown__deadline {
  font-size: 22rpx;
  color: #8B8FA8;
}

/* 赛事亮点 */
.highlights {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
}
.highlights__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1B2E;
  margin-bottom: 20rpx;
}
.highlights__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #8B8FA8;
}
.highlights__row:last-child {
  margin-bottom: 0;
}
.highlights__icon {
  font-size: 24rpx;
}
.highlights__text {
  color: #8B8FA8;
}

/* 提醒按钮 */
.remind {
  width: 100%;
  padding: 26rpx;
  border-radius: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid rgba(139, 92, 246, 0.3);
  background: rgba(139, 92, 246, 0.07);
  color: #7C3AED;
  transition: all 0.2s;
}
.remind--done {
  border: 1rpx solid rgba(16, 185, 129, 0.3);
  background: rgba(16, 185, 129, 0.07);
  color: #059669;
}

/* ===== 报名中：进度 ===== */
.progress {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}
.progress__head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.progress__label {
  font-size: 24rpx;
  color: #8B8FA8;
}
.progress__value {
  font-size: 24rpx;
  color: #1A1B2E;
  font-weight: 600;
}
.progress__track {
  height: 8rpx;
  background: #F3F4F8;
  border-radius: 4rpx;
}
.progress__bar {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #FF2D55, #FF6B8A);
}
.progress__deadline {
  font-size: 22rpx;
  color: #8B8FA8;
  margin-top: 10rpx;
}

/* 报名表单 */
.form {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
}
.form__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1B2E;
  margin-bottom: 24rpx;
}
.field {
  margin-bottom: 24rpx;
}
.field:last-child {
  margin-bottom: 0;
}
.field__label {
  font-size: 24rpx;
  color: #8B8FA8;
  margin-bottom: 12rpx;
}
.field__input {
  background: #F3F4F8;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #1A1B2E;
}
.field__ph {
  color: #8B8FA8;
}
.field__opts {
  display: flex;
  gap: 12rpx;
}
.field__opts--wrap {
  flex-wrap: wrap;
}
.opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  background: transparent;
  color: #8B8FA8;
  transition: all 0.15s;
}
.field__opts--wrap .opt {
  flex: 1 1 auto;
  min-width: 140rpx;
  padding: 16rpx 20rpx;
}
.opt--active {
  border: 1rpx solid #FF2D55;
  background: rgba(255, 45, 85, 0.1);
  color: #FF2D55;
  font-weight: 600;
}

/* 提交按钮 */
.submit {
  width: 100%;
  padding: 26rpx;
  border-radius: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF2D55, #FF6B8A);
  transition: all 0.2s;
}
.submit--disabled {
  background: #F3F4F8;
  color: #8B8FA8;
}

/* 报名成功 */
.success {
  text-align: center;
  padding: 32rpx 0;
}
.success__emoji {
  font-size: 104rpx;
  margin-bottom: 24rpx;
}
.success__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1B2E;
  margin-bottom: 12rpx;
}
.success__desc {
  font-size: 26rpx;
  color: #8B8FA8;
  margin-bottom: 40rpx;
}
.success__card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: left;
}
.success__label {
  font-size: 22rpx;
  color: #8B8FA8;
  margin-bottom: 12rpx;
}
.success__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1B2E;
}
.success__meta {
  font-size: 24rpx;
  color: #8B8FA8;
  margin-top: 6rpx;
}

/* ===== 已结束：统计 ===== */
.stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.stats__item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
}
.stats__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #E8960A;
}
.stats__label {
  font-size: 20rpx;
  color: #8B8FA8;
  margin-top: 4rpx;
}

/* 获奖名单筛选 */
.rank-filter {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.rank-filter__style {
  padding: 8rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  background: #F3F4F8;
  color: #8B8FA8;
  transition: all 0.15s;
}
.rank-filter__style--active {
  background: #FF2D55;
  color: #FFFFFF;
}
.rank-filter--age {
  gap: 12rpx;
}
.rank-filter__age {
  padding: 6rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  background: transparent;
  color: #8B8FA8;
  font-weight: 400;
  transition: all 0.15s;
}
.rank-filter__age--active {
  background: rgba(245, 166, 35, 0.15);
  color: #E8960A;
  font-weight: 600;
}

.rank-empty {
  text-align: center;
  padding: 56rpx 0;
  color: #8B8FA8;
  font-size: 26rpx;
}

/* 名单行 */
.rank-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.rank-row__num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
.rank-row__main {
  flex: 1;
  min-width: 0;
}
.rank-row__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1B2E;
}
.rank-row__school {
  font-size: 22rpx;
  color: #8B8FA8;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-row__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}
.rank-row__award {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
.rank-row__score {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1B2E;
}
