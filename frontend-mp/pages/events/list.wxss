.events {
  min-height: 100vh;
  background: #F8F8FC;
  padding: 24rpx 24rpx 40rpx;
}

/* ===== 顶部品牌头 ===== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.head__title {
  font-family: 'Noto Serif SC', 'STSong', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1B2E;
  letter-spacing: -1rpx;
}
.head__sub {
  font-size: 22rpx;
  color: #8B8FA8;
  margin-top: 4rpx;
}
.head__bell {
  position: relative;
  font-size: 44rpx;
}
.head__dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF2D55;
  border: 3rpx solid #F8F8FC;
}

/* ===== 搜索 ===== */
.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F3F4F8;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.search__icon {
  font-size: 26rpx;
  color: #8B8FA8;
}
.search__input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1B2E;
}

/* ===== 状态筛选 ===== */
.filters {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.filter {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #F3F4F8;
  color: #8B8FA8;
  transition: all 0.15s;
}
.filter--active {
  background: #FF2D55;
  color: #fff;
}

/* ===== 列表 ===== */
.list {
  margin-top: 20rpx;
}
.count {
  font-size: 22rpx;
  color: #8B8FA8;
  margin-bottom: 20rpx;
}

/* ===== 卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.card:active {
  transform: scale(0.99);
}

.card__cover {
  height: 160rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  padding: 0 24rpx 20rpx;
}
.card__deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}
.card__deco--1 {
  top: 16rpx;
  right: 16rpx;
  width: 88rpx;
  height: 88rpx;
}
.card__deco--2 {
  top: 36rpx;
  right: 44rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.06);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.card__body {
  padding: 20rpx 24rpx 24rpx;
}
.card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1B2E;
  line-height: 1.4;
  margin-bottom: 14rpx;
}
.card__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #8B8FA8;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}
.card__meta-icon {
  font-size: 22rpx;
}

.card__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}
.chip {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.chip--style {
  background: rgba(255, 45, 85, 0.1);
  color: #FF6B8A;
  border: 1rpx solid rgba(255, 45, 85, 0.2);
}
.chip--age {
  background: rgba(245, 166, 35, 0.1);
  color: #F5C55C;
  border: 1rpx solid rgba(245, 166, 35, 0.2);
}

.card__foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card__foot-text {
  font-size: 22rpx;
  color: #8B8FA8;
}
.card__foot-more {
  font-size: 22rpx;
  color: #FF2D55;
  font-weight: 500;
}
