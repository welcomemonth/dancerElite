<view class="article-page">
  <!-- 未选栏目（从 tabBar 直接进入） -->
  <view wx:if="{{noColumn}}" class="no-column">
    <view class="no-column__icon">📚</view>
    <view class="no-column__title">先去首页选个栏目吧</view>
    <view class="no-column__desc">不同栏目下的精彩内容等你发现</view>
    <button class="btn btn-primary btn-lg" bindtap="onGoSelectColumn">去首页</button>
  </view>

  <!-- 列表 -->
  <view wx:if="{{!noColumn}}" class="list">
    <view
      class="article-item card-hover"
      wx:for="{{articles}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onArticleTap"
    >
      <image
        wx:if="{{item.thumbnail}}"
        class="article-item__thumb"
        src="{{item.thumbnail}}"
        mode="aspectFill"
        lazy-load="true"
      />
      <view class="article-item__thumb article-item__thumb--placeholder" wx:else>
        <text>无图</text>
      </view>

      <view class="article-item__main">
        <view class="article-item__title">{{item.title}}</view>
        <view class="article-item__meta">
          <text class="meta-author">{{item.author || '佚名'}}</text>
          <text class="meta-dot">·</text>
          <text class="meta-views">{{item.view_count || 0}} 次浏览</text>
        </view>
        <view class="article-item__date">{{item.created_at}}</view>
      </view>
    </view>
  </view>

  <!-- 骨架屏（首次加载） -->
  <view wx:if="{{!noColumn && loading && articles.length === 0}}" class="list">
    <view class="article-item" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="article-item__thumb skeleton-shimmer"></view>
      <view class="article-item__main">
        <view class="skeleton-line skeleton-line--lg skeleton-shimmer"></view>
        <view class="skeleton-line skeleton-line--md skeleton-shimmer"></view>
        <view class="skeleton-line skeleton-line--sm skeleton-shimmer"></view>
      </view>
    </view>
  </view>

  <!-- 加载中（分页） -->
  <view wx:if="{{!noColumn && loading && articles.length > 0}}" class="loading-more">
    <text>加载中…</text>
  </view>

  <!-- 没有更多 -->
  <view wx:if="{{!noColumn && !hasMore && articles.length > 0}}" class="no-more">
    <view class="no-more__line"></view>
    <text>已经到底啦</text>
    <view class="no-more__line"></view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!noColumn && !loading && articles.length === 0}}" class="empty-state">
    <view class="empty-state__icon">📄</view>
    <text>该栏目还没有文章</text>
  </view>
</view>
