.detail {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 160rpx;
}

/* ===== 文章 ===== */
.article {
  padding: 40rpx 32rpx 60rpx;
}

.article__head {
  margin-bottom: 24rpx;
}

.article__column {
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}
.tag-brand {
  background: #eff6ff;
  color: #1d4ed8;
  font-weight: 500;
}

.article__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
  letter-spacing: -0.5rpx;
  margin-bottom: 20rpx;
}

.article__meta {
  font-size: 24rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}
.meta-dot {
  color: #cbd5e1;
}

.article__divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 0 32rpx;
}

.article__body {
  padding: 30rpx 32rpx 40rpx;
  font-size: 30rpx;
  line-height: 1.85;
  color: #0f172a;
}

.article__body rich-text {
  display: block;
}

.article__body image {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 24rpx 0;
  border-radius: 12rpx;
}

.article__body video {
  width: 100%;
  height: auto;
  margin: 24rpx 0;
  border-radius: 12rpx;
}

.article__body p {
  margin: 20rpx 0;
}

.article__body h1,
.article__body h2,
.article__body h3,
.article__body h4 {
  margin: 36rpx 0 18rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.4;
}
.article__body h1 { font-size: 38rpx; }
.article__body h2 { font-size: 34rpx; }
.article__body h3 { font-size: 32rpx; }
.article__body h4 { font-size: 30rpx; }

.article__body blockquote {
  padding: 20rpx 28rpx;
  margin: 24rpx 0;
  background: #f8fafc;
  border-left: 6rpx solid #2563eb;
  border-radius: 8rpx;
  color: #475569;
}

.article__body pre {
  background: #0f172a;
  color: #e2e8f0;
  padding: 24rpx;
  border-radius: 12rpx;
  overflow-x: auto;
  font-size: 26rpx;
  line-height: 1.6;
  margin: 24rpx 0;
}

.article__body code {
  background: #f1f5f9;
  color: #1d4ed8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 26rpx;
  font-family: ui-monospace, monospace;
}

.article__body a {
  color: #2563eb;
  text-decoration: underline;
}

.article__footer {
  text-align: center;
  padding: 40rpx 32rpx 0;
  color: #cbd5e1;
  font-size: 22rpx;
}

/* ===== 骨架 ===== */
.skeleton {
  padding: 40rpx 32rpx;
}
.skeleton-line {
  height: 26rpx;
  border-radius: 6rpx;
  margin-bottom: 24rpx;
}
.skeleton-line:last-child { margin-bottom: 0; }
.skeleton-line--xl {
  height: 50rpx;
  width: 90%;
}
.skeleton-line--md { width: 50%; height: 22rpx; }
.skeleton-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 32rpx 0;
}
.skeleton-shimmer {
  background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}
.empty-state__icon {
  font-size: 110rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-top: 1rpx solid #f1f5f9;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 18rpx rgba(15, 23, 42, 0.05);
  z-index: 10;
}

.action-item,
.action-share {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  background: transparent;
  border: none;
  font-size: 22rpx;
  color: #475569;
  line-height: 1.2;
  transition: transform 0.15s ease;
}
.action-share::after {
  border: none;
}
.action-item:active,
.action-share:active {
  transform: scale(0.94);
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #475569;
}
