<view class="home">
  <!-- 顶部 banner -->
  <view class="banner">
    <view class="banner__glow banner__glow--1"></view>
    <view class="banner__glow banner__glow--2"></view>
    <view class="banner__content">
      <view class="banner__title">远山平台</view>
      <view class="banner__subtitle">一站式内容 · 活动 · 用户运营</view>
    </view>
  </view>

  <!-- 内容卡片区 -->
  <view class="content-wrap">
    <view class="section-head">
      <view class="section-head__title">栏目分类</view>
      <view class="section-head__more" wx:if="{{!loading && columns.length > 0}}">{{columns.length}} 个栏目</view>
    </view>

    <!-- 骨架屏 -->
    <view wx:if="{{loading}}" class="skeleton-list">
      <view class="skeleton-item" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="skeleton-line skeleton-line--lg"></view>
        <view class="skeleton-line skeleton-line--md"></view>
      </view>
    </view>

    <!-- 栏目网格 -->
    <view wx:elif="{{columns.length > 0}}" class="column-grid">
      <view
        class="column-card"
        wx:for="{{columns}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onColumnTap"
      >
        <view class="column-card__icon">{{item.name[0] || '#'}}</view>
        <view class="column-card__name">{{item.name}}</view>
        <view class="column-card__desc">{{item.description || '探索更多精彩内容'}}</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <view class="empty-state__icon">📭</view>
      <text>暂无栏目内容</text>
    </view>
  </view>
</view>
