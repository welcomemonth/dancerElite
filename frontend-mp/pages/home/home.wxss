.home {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 40rpx;
}

/* ===== 顶部 banner ===== */
.banner {
  background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 60%, #1e3a8a 100%);
  color: #ffffff;
  padding: 60rpx 40rpx 110rpx;
  position: relative;
  overflow: hidden;
}
.banner__glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(40rpx);
}
.banner__glow--1 {
  width: 320rpx;
  height: 320rpx;
  background: rgba(96, 165, 250, 0.4);
  top: -100rpx;
  right: -80rpx;
}
.banner__glow--2 {
  width: 220rpx;
  height: 220rpx;
  background: rgba(147, 197, 253, 0.3);
  bottom: -50rpx;
  left: -50rpx;
}
.banner__content {
  position: relative;
}
.banner__title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin-bottom: 12rpx;
}
.banner__subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ===== 内容区 ===== */
.content-wrap {
  margin: -50rpx 24rpx 0;
  padding: 0;
  position: relative;
  z-index: 1;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 24rpx;
}
.section-head__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}
.section-head__more {
  font-size: 24rpx;
  color: #94a3b8;
}

/* ===== 栏目卡片网格 ===== */
.column-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.column-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  position: relative;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.column-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}

.column-card__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.25);
}

.column-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.column-card__desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 骨架屏 ===== */
.skeleton-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.skeleton-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}
.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
  background-size: 200% 100%;
  border-radius: 6rpx;
  animation: shimmer 1.4s ease infinite;
}
.skeleton-line--lg {
  width: 60%;
  margin-bottom: 16rpx;
}
.skeleton-line--md {
  width: 90%;
  height: 20rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}
.empty-state__icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}
