.register {
  min-height: 100vh;
  background: #f8fafc;
  padding: 60rpx 32rpx 80rpx;
}

/* ===== 头部 ===== */
.register__head {
  text-align: center;
  margin-bottom: 48rpx;
}

.register__icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 12rpx 32rpx rgba(37, 99, 235, 0.30);
  color: #ffffff;
}
.register__icon--ok {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.30);
  font-size: 64rpx;
  font-weight: 700;
}

/* 已注册信息行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.info-row:last-of-type {
  border-bottom: none;
}
.info-row__label {
  font-size: 28rpx;
  color: #94a3b8;
}
.info-row__value {
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 500;
}
.mt-16 {
  margin-top: 32rpx;
}

.register__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.register__subtitle {
  font-size: 26rpx;
  color: #94a3b8;
}

/* ===== 表单卡 ===== */
.register__card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.form-field {
  margin-bottom: 28rpx;
}

.form-field__label {
  display: block;
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 92rpx;
  transition: all 0.18s ease;
}
.input-wrap.is-focus {
  background: #ffffff;
  border-color: #2563eb;
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.10);
}
.input-wrap input {
  flex: 1;
  height: 92rpx;
  font-size: 30rpx;
  color: #0f172a;
}

/* ===== 按钮 ===== */
.submit-btn {
  margin-top: 12rpx;
}

/* ===== 提示卡 ===== */
.register__hint {
  margin-top: 40rpx;
  padding: 28rpx 32rpx;
  background: #eff6ff;
  border-radius: 16rpx;
  border-left: 6rpx solid #2563eb;
}

.register__hint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d4ed8;
  margin-bottom: 12rpx;
}

.register__hint-text {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}
